          "required": true,
          "timeout": "2m0s",
          "trustedFiles": [
            "scripts/xgoal/gofmt-check.sh"
          ],
          "type": "command"
        },
        {
          "argv": [
            "go",
            "test",
            "./..."
          ],
          "description": "Run the repository Go test suite; inspect its assertions for business coverage.",
          "env": {},
          "flaky": {},
          "id": "go-test-all",
          "phases": [
            "change",
            "final"
          ],
          "required": true,
          "timeout": "20m0s",
          "type": "command"
        },
        {
          "argv": [
            "go",
            "test",
            "-race",
            "./..."
          ],
          "description": "Run the Go test suite with the race detector.",
          "env": {},
          "flaky": {},
          "id": "go-race",
          "phases": [
            "final"
          ],
          "required": true,
          "timeout": "40m0s",
          "type": "command"
        }
      ],
      "workspace": {
        "cleanupCompletedAfter": "168h0m0s",
        "keepFailed": true,
        "provider": "current-directory"
      }
    }
