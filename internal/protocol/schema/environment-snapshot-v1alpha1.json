{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xgoal.dev/schema/xgoal.environment-snapshot/v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "id", "os", "kernel", "arch", "isolation_level", "git_version", "base_commit", "base_tree", "tool_versions", "lockfile_hashes", "config_hash", "goal_revision_hash", "environment_names", "captured_at"],
  "properties": {
    "protocol_version": {"const": "xgoal.environment-snapshot/v1alpha1"},
    "id": {"type": "string", "minLength": 1},
    "os": {"type": "string", "minLength": 1},
    "kernel": {"type": "string", "minLength": 1},
    "arch": {"type": "string", "minLength": 1},
    "isolation_level": {"const": "L0"},
    "git_version": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "minLength": 1},
    "base_tree": {"type": "string", "minLength": 1},
    "tool_versions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "lockfile_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "goal_revision_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_names": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "bootstrap_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "captured_at": {"type": "string", "format": "date-time"}
  }
}
