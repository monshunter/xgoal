{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xgoal.dev/schema/xgoal.work-packet/v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "project", "goal", "work_item", "role", "constraints", "environment", "required_output_schema"],
  "properties": {
    "harness": {"type":"object","additionalProperties":false,"required":["type","provider","required","found","compatible","files","delegation","delivery","load_observation"],"properties":{"type":{"type":"string"},"provider":{"type":"string","minLength":1},"required":{"type":"boolean"},"found":{"type":"boolean"},"compatible":{"type":"boolean"},"files":{"type":"array","maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["path","kind","sha256"],"properties":{"path":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},"diagnostics":{"type":"array","items":{"type":"string"}},"delegation":{"type":"string","minLength":1,"maxLength":8192},"delivery":{"const":"packet-path-references"},"load_observation":{"const":"unknown"}}},
    "protocol_version": {"const": "xgoal.work-packet/v1alpha1"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "base_tree", "workspace"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "base_tree": {"type": "string", "minLength": 1},
        "workspace": {"type": "string", "minLength": 1}
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "summary", "contract_hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "summary": {"type": "string", "minLength": 1},
        "contract_hash": {"type": "string", "minLength": 1}
      }
    },
    "work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "objective", "read_scope", "write_scope", "acceptance_criteria", "validator_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "read_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "write_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "validator_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "role": {"enum": ["planner", "implementer", "reviewer"]},
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_network", "project_secrets", "git_push", "production"],
      "properties": {
        "project_network": {"enum": ["deny", "require-gate", "allow"]},
        "project_secrets": {"enum": ["deny", "require-gate"]},
        "git_push": {"const": false},
        "production": {"const": false}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {"type": "string"},
        "arch": {"type": "string"},
        "git_commit": {"type": "string"},
        "tool_versions": {"type": "object", "additionalProperties": {"type": "string"}},
        "lockfile_hashes": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "prior_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_class", "failure_fingerprint"],
      "properties": {
        "failure_class": {"type": "string", "minLength": 1},
        "failure_fingerprint": {"type": "string", "minLength": 1},
        "failure_error": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "decisions": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["gate_id", "gate_version", "answer"],
          "properties": {
            "gate_id": {"type": "string", "minLength": 1},
            "gate_version": {"type": "integer", "minimum": 1},
            "answer": {"type": "string", "minLength": 1}
          }
        }}
      }
    },
    "required_output_schema": {"const": "xgoal.agent-result/v1alpha1"}
  }
}
