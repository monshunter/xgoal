{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xgoal.dev/schema/xgoal.patch-bundle/v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "attempt_id", "base_commit", "base_tree", "entries", "objects", "manifest_hash", "bundle_hash"],
  "properties": {
    "protocol_version": {"const": "xgoal.patch-bundle/v1alpha1"},
    "attempt_id": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "minLength": 1},
    "base_tree": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "path_before": {"type": "string", "minLength": 1},
          "kind": {"enum": ["added", "modified", "deleted", "renamed"]},
          "mode_before": {"enum": ["100644", "100755", "120000"]},
          "mode_after": {"enum": ["100644", "100755", "120000"]},
          "content_hash_before": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "content_hash_after": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "object_ref": {"type": "string", "pattern": "^objects/sha256/[0-9a-f]{64}$"}
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "hash", "length"],
        "properties": {
          "ref": {"type": "string", "pattern": "^objects/sha256/[0-9a-f]{64}$"},
          "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "length": {"type": "integer", "minimum": 0}
        }
      }
    },
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
