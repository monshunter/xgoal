{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xgoal.dev/schema/xgoal.review-packet/v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "id", "goal_revision_hash", "plan_revision_hash", "work_item_id", "implementation_attempt_id", "implementation_profile_id", "implementation_session_id", "base_tree", "candidate_tree", "config_hash", "workspace", "patch_bundle_path", "patch_bundle_hash", "validator_receipts", "required_checks", "reviewer_profile_id"],
  "properties": {
    "protocol_version": {"type": "string", "const": "xgoal.review-packet/v1alpha1"},
    "id": {"type": "string", "minLength": 1},
    "goal_revision_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_revision_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "work_item_id": {"type": "string", "minLength": 1},
    "implementation_attempt_id": {"type": "string", "minLength": 1},
    "implementation_profile_id": {"type": "string", "minLength": 1},
    "implementation_session_id": {"type": "string", "minLength": 1},
    "base_tree": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "candidate_tree": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspace": {"type": "string", "minLength": 1},
    "patch_bundle_path": {"type": "string", "minLength": 1},
    "patch_bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validator_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "hash"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "required_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reviewer_profile_id": {"type": "string", "minLength": 1}
  }
}
